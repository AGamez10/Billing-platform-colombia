# Producción: copia a deploy/.env en el servidor (chmod 600) y completa. Nunca al repositorio.
# Los secretos aleatorios los genera scripts/init-secrets.sh; aquí van vacíos a propósito.

# --- Versión desplegada (etiqueta de las imágenes publicadas por el flujo "Release") ---
BILLING_VERSION=
# Registro de imágenes (por defecto GitHub Container Registry del repositorio).
# BILLING_IMAGE_REGISTRY=ghcr.io/agamez10

# --- Dominio y marca ---
# Solo el dominio, sin https:// (el DNS A/AAAA debe apuntar al VPS antes de arrancar).
BILLING_DOMAIN=
# Correo para avisos de Let's Encrypt (vencimiento de certificados).
ACME_EMAIL=
BILLING_BRAND_NAME=

# --- Secretos (scripts/init-secrets.sh los genera si están vacíos) ---
POSTGRES_SUPERUSER_PASSWORD=
BILLING_DB_OWNER_PASSWORD=
BILLING_DB_APP_PASSWORD=
BILLING_JWT_SECRET=
# Cifra las llaves de pasarelas guardadas en la base (AES-GCM). Si se pierde, hay que
# reconectar las cuentas Bold de los comercios: guárdala también en tu gestor de contraseñas.
BILLING_SECRETS_KEY=

# --- Correo transaccional (recuperar contraseña, invitaciones) ---
BILLING_MAIL_FROM=
BILLING_SMTP_HOST=
BILLING_SMTP_PORT=587
BILLING_SMTP_USERNAME=
BILLING_SMTP_PASSWORD=

# --- Pago de planes con Mercado Pago (ADR-0024). Vacío = pago en línea deshabilitado ---
BILLING_MERCADOPAGO_ACCESS_TOKEN=
BILLING_MERCADOPAGO_WEBHOOK_SECRET=
# true en producción: un pago de prueba nunca activa un plan. false solo con credenciales de prueba.
BILLING_MERCADOPAGO_REQUIRE_LIVE_MODE=true

# --- Copias de seguridad (scripts/backup.sh) ---
# Llave PÚBLICA age (age1...). La privada NO va en el servidor: guárdala fuera (ver DEPLOYMENT.md).
BACKUP_AGE_RECIPIENT=
# Destino externo de rclone (p. ej. b2:mi-bucket/billing). Vacío = solo copia local (no recomendado).
BACKUP_RCLONE_REMOTE=
BACKUP_LOCAL_DAYS=7
BACKUP_REMOTE_DAYS=30

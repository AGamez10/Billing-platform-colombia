# Copia este archivo como .env y cambia los valores. .env nunca se sube al repositorio.
POSTGRES_SUPERUSER_PASSWORD=cambia-esto-superusuario
BILLING_DB_OWNER_PASSWORD=cambia-esto-dueno
BILLING_DB_APP_PASSWORD=cambia-esto-app
# Puerto local de la página y la API (cámbialo si 8080 ya está ocupado)
BILLING_HTTP_PORT=8080
# Secreto de los access tokens (base64, >= 32 bytes). Generar: openssl rand -base64 48
BILLING_JWT_SECRET=
